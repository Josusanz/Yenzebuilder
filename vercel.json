{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/builder",
      "destination": "/builder.html",
      "has": [
        {
          "type": "host",
          "value": "builder.yenze.io"
        }
      ]
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/view-project.js?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
