{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/builder.html",
      "has": [
        {
          "type": "host",
          "value": "builder.yenze.io"
        }
      ]
    },
    {
      "source": "/s/:slug",
      "destination": "/api/view-project.js?slug=:slug",
      "has": [
        {
          "type": "host",
          "value": "yenze.io"
        }
      ]
    },
    {
      "source": "/s/:slug",
      "destination": "/api/view-project.js?slug=:slug",
      "has": [
        {
          "type": "host",
          "value": "www.yenze.io"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/landing.html",
      "has": [
        {
          "type": "host",
          "value": "yenze.io"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/landing.html",
      "has": [
        {
          "type": "host",
          "value": "www.yenze.io"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/api/view-subdomain.js",
      "missing": [
        {
          "type": "host",
          "value": "yenze.io"
        },
        {
          "type": "host",
          "value": "www.yenze.io"
        },
        {
          "type": "host",
          "value": "builder.yenze.io"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
