{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/builder.html",
      "has": [
        {
          "type": "host",
          "value": "builder.yenze.io"
        }
      ]
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/builder",
      "destination": "/builder.html"
    },
    {
      "source": "/",
      "destination": "/landing.html",
      "has": [
        {
          "type": "host",
          "value": "yenze.io"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/landing.html",
      "has": [
        {
          "type": "host",
          "value": "www.yenze.io"
        }
      ]
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/prompt-generator",
      "destination": "/prompt-generator.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/view-project.js?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/api/subdomain.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}