{
  "routes": [
    {
      "src": "/",
      "dest": "/landing.html",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/builder.html",
      "has": [
        {
          "type": "host",
          "value": "builder.yenze.io"
        }
      ]
    }
  ]
}
